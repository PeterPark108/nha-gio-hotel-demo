# Mẫu file cấu hình. KHÔNG điền giá trị thật vào repo.
# Trên máy chủ: copy thành /etc/nha-gio/admin.env, chmod 640, chủ sở hữu root:nhagio.
# Tạo giá trị ngẫu nhiên:  python3 -m admin.manage new-secrets
NHAGIO_ADMIN_PATH=quan-tri-THAY-BANG-CHUOI-NGAU-NHIEN
NHAGIO_SECRET=THAY-BANG-CHUOI-NGAU-NHIEN-TOI-THIEU-32-KY-TU
NHAGIO_SITE_ROOT=/srv/nha-gio/site
NHAGIO_VAR=/srv/nha-gio/var
NHAGIO_WEB_ROOT=/srv/nha-gio/www
NHAGIO_RELEASES=/srv/nha-gio/releases
NHAGIO_PUBLIC_URL=https://gio.myagentvn.com
NHAGIO_COOKIE_SECURE=1
NHAGIO_TRUST_PROXY=1
# Tùy chọn (giá trị mặc định):
# NHAGIO_IDLE_SECONDS=43200        # 12 giờ không hoạt động thì hết phiên
# NHAGIO_ABSOLUTE_SECONDS=604800   # phiên dài tối đa 7 ngày
# NHAGIO_IP_MAX_FAIL=5             # sai 5 lần / 15 phút / IP thì khóa IP
# NHAGIO_GLOBAL_MAX_FAIL=30        # sai 30 lần toàn hệ thống thì khóa chung 10 phút
# NHAGIO_KEEP_BACKUPS=30
# NHAGIO_KEEP_RELEASES=5
